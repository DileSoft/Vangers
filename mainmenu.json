- type: comment
  content: |-
    /* -------------------------------------------------------------------------- */
- type: block
  blockType: Screen
  name: "Main Screen"
  children:
    - type: word
      raw: "default_obj"

    - type: string_quoted
      raw: ""New Game Option""

    - type: block
      blockType: Event
      children:
        - type: word
          raw: "key"

        - type: constant
          raw: "$VK_ESCAPE"

        - type: block
          blockType: EvComm
          children:
            - type: word
              raw: "exit"

            - type: word
              raw: "0"

    - type: block
      blockType: Object
      name: "Multiplayer Option"
      children:
        - type: word
          raw: "x"

        - type: constant
          raw: "$MULTIPLAYER_X"

        - type: word
          raw: "y"

        - type: constant
          raw: "$MULTIPLAYER_Y"

        - type: word
          raw: "selectable_obj"

        - type: word
          raw: "Element"

        - type: word
          raw: "STRING"

        - type: unknown
          raw: "{"

        - type: word
          raw: "align_x"

        - type: word
          raw: "center"

        - type: word
          raw: "terrain_num"

        - type: constant
          raw: "$TERRAIN2"

        - type: word
          raw: "font"

        - type: constant
          raw: "$MAIN_FNT"

        - type: word
          raw: "null_level"

        - type: constant
          raw: "$DEFAULT_NULL"

        - type: word
          raw: "string"

        - type: constant
          raw: "$iSTR_MULTIPLAYER"

    - type: block
      blockType: Event
      children:
        - type: word
          raw: "if_selected"

        - type: word
          raw: "key"

        - type: constant
          raw: "$VK_SPACE"

        - type: word
          raw: "key"

        - type: constant
          raw: "$VK_RETURN"

        - type: word
          raw: "key"

        - type: constant
          raw: "$VK_LBUTTON"

        - type: word
          raw: "time"

        - type: unknown
          raw: "{"

        - type: constant
          raw: "$PRESS_OBJ_TIME"

        - type: word
          raw: "+"

        - type: constant
          raw: "$MOVE2SCREEN_TIME"

        - type: word
          raw: "+"

        - type: word
          raw: "1"

    - type: block
      blockType: EvComm
