    			font		$MAIN_FNT
    			null_level	$DEFAULT_NULL
    			string		$iSTR_PLAYER_SETUP
    		}
    
    		Event {
    			if_selected
    			key $VK_SPACE
    			key $VK_RETURN
    			key $VK_LBUTTON
    
    			time { $PRESS_OBJ_TIME + $MOVE2SCREEN_TIME + 1 }
    			EvComm {
    				low_obj 	"Player Option"
    				time		$PRESS_OBJ_TIME
    				start_time	0
    			}
    			EvComm {
    				move2screen	"Configuration screen"
    				start_time	$PRESS_OBJ_TIME
    				time		$MOVE2SCREEN_TIME
    			}
    		}
    		Event {
    			if_not_selected
    			key $VK_RBUTTON
    
    			time { $PRESS_OBJ_TIME + $SMOOTH_OBJ_TIME + $HIDE_OBJ_TIME + $MOVE2SCREEN_TIME + 1 }
    			EvComm {
    				jump_obj	"Player Option"
    				start_time	$PRESS_OBJ_TIME
    			}
    			EvComm {
    				smooth_obj	"Player Option" 4
    				start_time	$PRESS_OBJ_TIME
    				time		$SMOOTH_OBJ_TIME
    			}
    			EvComm {
    				hide_obj	"Player Option"
    				start_time	{ $PRESS_OBJ_TIME + $SMOOTH_OBJ_TIME }
    				time		$HIDE_OBJ_TIME
    			}
    			EvComm {
    				low_obj 	"SELECTED_OBJ"
    				start_time	0
    				time		$PRESS_OBJ_TIME
    			}
    			EvComm {
    				rise_obj	"Player Option"
    				start_time	0
    				time		$PRESS_OBJ_TIME
    			}
    			EvComm {
    				move2screen	"Configuration screen"
    				start_time	{ $PRESS_OBJ_TIME + $SMOOTH_OBJ_TIME + $HIDE_OBJ_TIME }
    				time		$MOVE2SCREEN_TIME
    			}
    		}
    		Event {
    			if_selected
    			key $VK_RBUTTON
    
    			time { $SMOOTH_OBJ_TIME + $HIDE_OBJ_TIME + $MOVE2SCREEN_TIME + 1 }
    			EvComm {
    				smooth_obj	"Player Option" 4
    				start_time	0
    				time		$SMOOTH_OBJ_TIME
    			}
    			EvComm {
    				hide_obj	"Player Option"
    				start_time	$SMOOTH_OBJ_TIME
    				time		$HIDE_OBJ_TIME
    			}
    			EvComm {
    				move2screen	"Configuration screen"
    				start_time	{ $SMOOTH_OBJ_TIME + $HIDE_OBJ_TIME }
    				time		$MOVE2SCREEN_TIME
    			}
    		}
    
    		#define OBJ1	"SELECTED_OBJ"
    		#define OBJ2	"Player Option"
    		Event {
    			if_not_selected
    			key $VK_LBUTTON
    			key $VK_MOVE
    
    			$EV_CHANGE_OBJ
    		}
    
    		#define OBJ1	"Player Option"
    		#define OBJ2	"Port Option"
    		Event {
    			if_selected
    			key $VK_DOWN
    			key $VK_TAB
    
    			$EV_CHANGE_OBJ
    		}
    		#define OBJ1	"Player Option"
    		#define OBJ2	"Create Option"
    		Event {
    			if_selected
